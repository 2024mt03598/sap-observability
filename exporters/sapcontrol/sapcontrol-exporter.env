[Unit]
Description=SAPControl Prometheus exporter
After=network-online.target
Wants=network-online.target

[Service]
# Settings live in /etc/sapcontrol-exporter.env (see sapcontrol-exporter.env.example). The file is optional.
EnvironmentFile=-/etc/sapcontrol-exporter.env
ExecStart=/usr/bin/python3 /usr/local/bin/sapcontrol_exporter.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
